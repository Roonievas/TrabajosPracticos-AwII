DB_HOST=localhost
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=

# Clave secreta para firmar los JWT. Cualquier texto largo y aleatorio sirve
# (por ejemplo, generarlo con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=

# Clave secreta para firmar las cookies (cookie-parser). Igual que arriba,
# cualquier texto largo y aleatorio sirve.
COOKIE_SECRET=
